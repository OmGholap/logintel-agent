{
  "uid": "logintel-demo",
  "title": "Logintel demo logs",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "2026-05-26T12:02:30.000Z",
    "to": "2026-05-26T12:03:30.000Z"
  },
  "refresh": "",
